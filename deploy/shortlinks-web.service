[Unit]
Description=Short Links Web (sbzl.ir)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/shortlinks-web
ExecStart=/usr/bin/dotnet /var/www/shortlinks-web/ShortLinks.Api.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ENVIRONMENT=Production
User=shortlinks
Group=shortlinks

[Install]
WantedBy=multi-user.target
