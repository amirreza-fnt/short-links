[Unit]
Description=Short Links API (sbzlink)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/shortlinks
ExecStart=/usr/bin/dotnet /var/www/shortlinks/ShortLinks.Api.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ENVIRONMENT=Production
User=shortlinks
Group=shortlinks

[Install]
WantedBy=multi-user.target